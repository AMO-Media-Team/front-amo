# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/
# sesiones guardadas por e2e/preparacion.setup.ts (cookies de cuentas de prueba)
/playwright/.auth/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# documentos confidenciales del cliente (no se versionan)
/context/

# supabase local
/supabase/.branches
/supabase/.temp

# credenciales de cuentas de prueba por pista (scripts/bootstrap/cuenta-pista.ts)
/.cuentas-pista/
/.next-*/
