# ─────────────────────────────────────────────────────────────────────────────
# AMO — variables de entorno
# Copia este archivo a `.env.local` y completa los valores. Nunca subas secretos
# al repositorio ni los pongas en variables NEXT_PUBLIC_* (quedan en el navegador).
# `pnpm build` falla con un mensaje claro si falta una variable obligatoria
# (validación en src/lib/env-esquema.ts, invocada desde next.config.ts).
# ─────────────────────────────────────────────────────────────────────────────

# ── Públicas (se insertan en el bundle del navegador) ────────────────────────

# [Obligatoria] URL del proyecto Supabase (Panel → Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# [Obligatoria] Clave publicable (sb_publishable_…). Segura en el navegador gracias a RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# [Obligatoria] Token público de Mapbox (pk.…) restringido por URL
# (localhost, *.vercel.app y el dominio de producción).
NEXT_PUBLIC_MAPBOX_TOKEN=
# [Opcional] Estilo de Mapbox. Por defecto: mapbox://styles/mapbox/standard
NEXT_PUBLIC_MAPBOX_STYLE=
# [Opcional] URL pública del sitio (enlaces absolutos, metadatos). Por defecto: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Solo servidor ────────────────────────────────────────────────────────────

# [Obligatoria en producción] Secret key de Supabase (sb_secret_…). Solo la usan
# src/lib/supabase/admin.ts y auth-server.ts. En previews puede omitirse:
# las funciones de administración quedan deshabilitadas.
SUPABASE_SECRET_KEY=
# [Obligatoria] Clave AES-256-GCM para datos sensibles, formato k<n>:<base64 de 32 bytes>.
# Generar: echo "k1:$(openssl rand -base64 32)". El prefijo k<n> versiona la clave para rotarla.
AMO_CIFRADO_KEY=
# [Obligatoria] Secreto compartido servidor Next ↔ Postgres (Vault) para marcar el
# contexto confiable (cabecera x-amo-srv). Mínimo 32 caracteres: openssl rand -base64 48
AMO_SERVIDOR_SECRET=
# [Opcional] Correo del superadministrador inicial (pnpm bootstrap:superadmin).
SUPERADMIN_EMAIL=
# [Opcional] "true" cuando Supabase Auth tenga SMTP propio configurado. Por defecto: false
# (sin SMTP los enlaces de invitación/recuperación se generan y muestran a administradores).
AMO_SMTP_CONFIGURADO=false
# [Opcional] Cloudflare Turnstile en el inicio de sesión (definir ambas o ninguna).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# [Opcional] Modo de la Content-Security-Policy: "enforce" (por defecto) o "report"
# (solo informa violaciones en /api/csp-report; útil para depurar integraciones nuevas).
AMO_CSP_MODO=enforce

# --- Solo pruebas E2E locales (las crea `pnpm bootstrap:e2e`; nunca en Vercel) ---
# E2E_ADMIN_EMAIL=
# E2E_ADMIN_PASSWORD=
# E2E_ADMIN_TOTP_SECRET=
# E2E_ANUNCIANTE_EMAIL=
# E2E_ANUNCIANTE_PASSWORD=
# E2E_CAMBIO_EMAIL=
# E2E_CAMBIO_PASSWORD=
